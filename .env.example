IMAP_SERVER=://gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-app-specific-password
MAILBOX=INBOX

# Trigger keywords separated by commas (case-insensitive)
TARGET_KEYWORDS=URGENT,ASAP,PRIORITY 1,IMMEDIATE ACTION

# Action choices: 'TRASH' (moves to trash) or 'ARCHIVE' (removes from inbox)
ACTION=TRASH

# Dry run mode: set to True to log matches without deleting/moving them
DRY_RUN=True
